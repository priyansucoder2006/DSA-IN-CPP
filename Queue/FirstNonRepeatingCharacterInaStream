string firstNonRepeating(string A) {
    string ans;
    vector<int>frequency(26,0);
    queue<int>q;
    for(int i=0;i<A.size();i++){
        frequency[A[i]-'a']++;
        if(frequency[A[i]-'a']==1){
            q.push(A[i]);
        }
        while(!q.empty()&&frequency[q.front()-'a']>1){
            q.pop();
        }
        if(!q.empty()){
            ans.push_back(q.front());
        }
        else{
            ans.push_back('#');
        }

    }
    return ans;
    
}
