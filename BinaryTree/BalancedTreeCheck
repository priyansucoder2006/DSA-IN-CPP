class Solution {
public:
    // Function to check if a binary tree is balanced or not.
    int heightCal(Node* root, vector<int>&LeftHeight, vector<int>&RightHeight){
        if(!root){
            return 0;
        }
         if(!root->left&&!root->right){
            return 1;
        }
     int HeightofLeft = heightCal(root->left,LeftHeight,RightHeight);
     int  HeightofRight= heightCal(root->right,LeftHeight,RightHeight);
       LeftHeight.push_back(HeightofLeft);
       RightHeight.push_back(HeightofRight);
       return 1+ max( HeightofLeft, HeightofRight);
    }
    bool isBalanced(Node* root) {
        // code here
        vector<int>LeftHeight;
        vector<int>RightHeight;
        heightCal(root,LeftHeight,RightHeight);
        for(int i=0;i<LeftHeight.size();i++){
            if(abs(LeftHeight[i]-RightHeight[i])>1){
                return 0;
            }
        }
        return 1;
    }
};
