void permutation(vector<int>&nums,vector<vector<int>>&ans,int index,int n){
if(index==n-1){
    ans.push_back(nums);
    return;
}
vector<bool>used(21,0);
    for(int i=index;i<n;i++){
        if(!used[nums[i]+10]){
        used[nums[i]+10]=1;
        swap(nums[index],nums[i]);
        permutation(nums,ans,index+1,n);
        swap(nums[index],nums[i]);
        }
    }

}




class Solution {
public:
    vector<vector<int>> permuteUnique(vector<int>& nums) {
        // Code here 
        vector<vector<int>>ans;
        permutation(nums,ans,0,nums.size());
        return ans;

    }
};
