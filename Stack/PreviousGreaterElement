class Solution {
public:
    vector<int> previousGreaterElement(vector<int>& arr) {
        // Your code here
        vector<int>ans(arr.size(),-1);
        stack<int>st;
        for(int i=arr.size()-1;i>=0;i--){
            while(!st.empty()&&arr[i]>arr[st.top()]){
                ans[st.top()]=arr[i];
                st.pop();
            }
            st.push(i);
        }
        return ans;

    }
};
