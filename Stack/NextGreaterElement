vector<int> nextLargerElement(vector<int>& arr) {
vector<int>ans(arr.size(),-1);
stack<int>st;
for(int i=0;i<arr.size();i++){
 if(st.empty()){
    st.push(i);
 }
 else{
 if(arr[i]<arr[st.top()]){
    st.push(i);
 }
 else{
while(!st.empty()&&arr[i]>arr[st.top()]){
ans[st.top()]=arr[i];
 st.pop();
}
 st.push(i);
 }
 }   
}
return ans;
}
